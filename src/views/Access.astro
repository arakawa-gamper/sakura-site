---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import InfoList from '../components/InfoList.astro';
import TaxiCard from '../components/TaxiCard.astro';
import MapLinks from '../components/MapLinks.astro';
import { t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const a = d.access;
---
<Base lang={lang} page="access" title={d.seo.access.title} description={d.seo.access.description}>
  <PageHead title={a.title} lead={a.lead} />
  <section class="section">
    <div class="wrap info-grid">
      <div>
        <MapLinks lang={lang} />
        <h2 style="font-size:var(--step-2);margin-top:var(--space-l)">{a.directionsTitle}</h2>
        <ol class="steps simple">
          {a.directions.map((s) => <li><p>{s}</p></li>)}
        </ol>
      </div>
      <div>
        <InfoList lang={lang} />
        <div style="margin-top:var(--space-l)"><TaxiCard lang={lang} /></div>
      </div>
    </div>
  </section>
</Base>
