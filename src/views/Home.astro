---
import Base from '../layouts/Base.astro';
import CourseRow from '../components/CourseRow.astro';
import InfoList from '../components/InfoList.astro';
import TaxiCard from '../components/TaxiCard.astro';
import MapLinks from '../components/MapLinks.astro';
import site from '../data/site.json';
import menu from '../data/menu.json';
import lunch from '../data/lunch.json';
import InstagramIcon from '../components/InstagramIcon.astro';
import ReviewIcon from '../components/ReviewIcon.astro';
import drinks from '../data/drinks.json';
import { t, pagePath, withBase, pick, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const h = d.home;
const titleLines = h.heroTitle.split('\n').map((line) => line.split(/\{([^}]+)\}/));
const featured = menu.items.filter((i) => i.featured).slice(0, 3);
const prices = menu.items.map((i) => i.price);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: pick(site.name, lang),
  url: new URL(pagePath(lang, 'home'), Astro.site).href,
  image: new URL(withBase('images/hero.jpg'), Astro.site).href,
  telephone: site.phoneIntlDisplay,
  servesCuisine: ['Japanese', 'Sukiyaki', 'Shabu-shabu', 'Wagyu'],
  priceRange: site.priceRange,
  acceptsReservations: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.streetAddressEn,
    addressLocality: site.locality,
    addressRegion: site.region,
    postalCode: site.postalCode,
    addressCountry: 'JP',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: site.openingHoursSpec.map((o) => ({ '@type': 'OpeningHoursSpecification', ...o })),
  hasMenu: new URL(pagePath(lang, 'menu'), Astro.site).href,
  paymentAccepted: site.payments.join(', '),
  currenciesAccepted: 'JPY',
  makesOffer: { '@type': 'AggregateOffer', priceCurrency: 'JPY', lowPrice: Math.min(...prices), highPrice: Math.max(...prices) },
};
---
<Base lang={lang} page="home" title={d.seo.home.title} description={d.seo.home.description} jsonLd={jsonLd}>
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="hero-media">
      <img src={withBase('images/hero.jpg')} srcset={`${withBase('images/hero-sm.jpg')} 1300w, ${withBase('images/hero.jpg')} 2170w`} sizes="100vw" alt="" width="2170" height="725" fetchpriority="high" decoding="async" />
    </div>
    <div class="hero-logo">
      <img src={withBase('images/logo.webp')} alt={site.name.ja} width="480" height="537" />
    </div>
    <div class="hero-copy">
      <h1 id="hero-title">{titleLines.map((parts) => <span class="line">{parts.map((part, i) => (i % 2 ? <span class="gold">{part}</span> : part))}</span>)}</h1>
      <div class="hero-rule" aria-hidden="true">
        <span></span>
        <svg viewBox="0 0 24 24"><g fill="currentColor">{[0, 72, 144, 216, 288].map((r) => <path transform={`rotate(${r} 12 12)`} d="M12 12C9.4 10 8.9 6.4 10.6 4.4L12 5.9 13.4 4.4C15.1 6.4 14.6 10 12 12Z" />)}<circle cx="12" cy="12" r="1.3" /></g></svg>
        <span></span>
      </div>
      <p class="hero-lead">{h.heroLead.split('\n').map((line) => <span class="line">{line}</span>)}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={pagePath(lang, 'reserve')}>{d.ui.reserve}</a>
        <a class="btn btn-ghost" href={pagePath(lang, 'menu')}>{d.ui.viewMenu}</a>
      </div>
    </div>
  </section>

  <section class="feature on-dark" aria-labelledby="concept-title">
    <img src={withBase('images/concept.jpg')} alt="" width="1400" height="856" loading="lazy" decoding="async" />
    <div class="wrap">
      <div class="feature-body">
        <h2 id="concept-title">{h.conceptTitle}</h2>
        {h.introBody.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="styles-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="styles-title">{h.stylesTitle}</h2>
        <p>{h.stylesLead}</p>
      </div>
      <aside class="homemade" aria-label={(d.home as any).homemadeTitle}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="currentColor">{[0, 72, 144, 216, 288].map((r) => <path transform={`rotate(${r} 12 12)`} d="M12 12C9.4 10 8.9 6.4 10.6 4.4L12 5.9 13.4 4.4C15.1 6.4 14.6 10 12 12Z" />)}</g></svg>
        <div><p class="homemade-title">{(d.home as any).homemadeTitle}</p><p>{(d.home as any).homemadeBody}</p></div>
      </aside>
      <div class="styles-grid">
        {(['sukiyaki', 'shabushabu'] as const).map((k) => (
          <article class="style-col">
            <img src={withBase(`images/${k}.jpg`)} alt="" width="1200" height="800" loading="lazy" decoding="async" />
            <h3>{h[k].name}</h3>
            <p>{h[k].body}</p>
            <dl><dt>{h.tasteLabel}</dt><dd>{h[k].taste}</dd></dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="courses-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="courses-title">{h.coursesTitle}</h2>
        <p>{d.menu.lead}</p>
      </div>
      <ul class="course-list">
        {featured.map((item) => <CourseRow item={item} lang={lang} showCategory />)}
      </ul>
      <p class="more-link"><a class="btn btn-ink" href={pagePath(lang, 'menu')}>{d.ui.viewMenu}</a></p>
    </div>
  </section>

  <section class="section entrances" aria-label={`${(d.nav as any).lunch} / ${d.categories.drink}`}>
    <div class="wrap entrance-grid">
      <a class="entrance entrance-lunch" href={pagePath(lang, 'lunch')}>
        <img src={withBase('images/' + lunch.image)} alt="" width="952" height="550" loading="lazy" decoding="async" />
        <div class="entrance-body">
          <p class="eyebrow" lang="ja">{lunch.brand}</p>
          <h2>{h.lunchTitle}</h2>
          <p>{h.lunchBody}</p>
          <span class="btn btn-primary">{h.lunchCta}</span>
        </div>
      </a>
      <a class="entrance entrance-drink" href={pagePath(lang, 'menu') + '#drink'}>
        <div class="entrance-body">
          <p class="eyebrow">{d.categories.drink}</p>
          <h2>{h.drinkTitle}</h2>
          <p>{h.drinkBody}</p>
          <ul class="inbound-points">{drinks.highlights.map((x) => <li>{pick(x.title, lang)}</li>)}<li>{drinks.plans[0] && (d as any).drink.plansTitle}</li></ul>
          <span class="btn btn-ghost">{h.drinkCta}</span>
        </div>
      </a>
    </div>
  </section>

  <section class="feature is-right on-dark" aria-labelledby="banquet-title">
    <img src={withBase('images/banquet.jpg')} alt="" width="1800" height="1100" loading="lazy" decoding="async" />
    <div class="wrap">
      <div class="feature-body">
        <h2 id="banquet-title">{h.banquetTitle}</h2>
        <p>{h.banquetBody}</p>
        <a class="btn btn-primary" href={pagePath(lang, 'banquet')}>{h.banquetCta}</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="seats-title">
    <div class="wrap">
      <div class="section-head"><h2 id="seats-title">{d.banquet.seatsTitle}</h2></div>
      <div class="seat-grid">
        {d.banquet.seats.map((seat, i) => (
          <article class="seat">
            <img src={withBase(`images/seat-${i + 1}.jpg`)} alt={seat.name} width="1000" height="1250" loading="lazy" decoding="async" />
            <h3>{seat.name}</h3>
            <p class="capacity">{seat.capacity}</p>
            <p>{seat.body}</p>
          </article>
        ))}
      </div>
      <p class="muted" style="margin-top:1.5rem">{d.banquet.seatsNote}</p>
    </div>
  </section>

  <section class="section inbound" aria-labelledby="inbound-title">
    <div class="wrap inbound-grid">
      <div class="inbound-text">
        <h2 id="inbound-title">{h.inboundTitle}</h2>
        <p>{h.inboundBody}</p>
        <ul class="inbound-points">{h.inboundPoints.map((pt) => <li>{pt}</li>)}</ul>
        <p class="more-link btn-row"><a class="btn btn-primary" href={pagePath(lang, 'welcome')}>{(h as any).inboundMore}</a><a class="btn btn-ghost" href={(site.tripadvisor as any)[lang]} target="_blank" rel="noopener"><ReviewIcon /> {(d.ui as any).tripadvisor}</a></p>
      </div>
      <div class="inbound-photo">
        <img src={withBase('images/inbound-2.jpg')} alt={h.inboundAlt[1]} width="1024" height="935" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="band on-dark" aria-labelledby="first-title">
    <div class="wrap">
      <div>
        <h2 id="first-title">{h.firstTitle}</h2>
        <p>{h.firstBody}</p>
      </div>
      <a class="btn btn-ghost" href={pagePath(lang, 'guide')}>{d.ui.viewGuide}</a>
    </div>
  </section>

  <section class="section" aria-labelledby="gallery-title">
    <div class="wrap">
      <div class="section-head"><h2 id="gallery-title">{h.galleryTitle}</h2></div>
      <div class="gallery">
        {h.galleryAlt.map((alt, i) => (
          <figure><img src={withBase(`images/gallery-${i + 1}.jpg`)} alt={alt} width="900" height="1200" loading="lazy" decoding="async" /><figcaption>{alt}</figcaption></figure>
        ))}
      </div>
    </div>
  </section>

  <section class="band sns-band" aria-labelledby="sns-title">
    <div class="wrap">
      <div>
        <p class="eyebrow">Instagram {site.instagramHandle}</p>
        <h2 id="sns-title">{h.snsTitle}</h2>
        <p>{h.snsBody}</p>
      </div>
      <a class="btn btn-primary" href={site.instagram} target="_blank" rel="noopener"><InstagramIcon /> {h.snsCta}</a>
    </div>
  </section>

  <section class="section recruit-home" aria-labelledby="recruit-title">
    <div class="wrap recruit-home-grid">
      <img src={withBase('images/recruit-p1.jpg')} alt={site.recruit.partImages[0][1]} width="1200" height="900" loading="lazy" decoding="async" />
      <div>
        <p class="eyebrow">Recruit</p>
        <h2 id="recruit-title">{lang === 'ja' ? '一緒に働く仲間を募集しています' : (d as any).recruit.title}</h2>
        <p>{(d as any).recruit.body}</p>
        <p class="more-link"><a class="btn btn-primary" href={pagePath(lang, 'recruit')}>{(d as any).recruit.cta}</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="info-title">
    <div class="wrap">
      <div class="section-head"><h2 id="info-title">{h.infoTitle}</h2></div>
      <div class="info-grid">
        <InfoList lang={lang} />
        <div>
          {lang !== 'ja' && <TaxiCard lang={lang} />}
          <div style={lang !== 'ja' ? 'margin-top:1.5rem' : ''}><MapLinks lang={lang} /></div>
        </div>
      </div>
    </div>
  </section>
</Base>
