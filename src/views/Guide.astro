---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { t, pagePath, withBase, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const g = d.guide;
const blocks = [
  { id: 'sukiyaki', title: g.sukiyakiTitle, steps: g.sukiyakiSteps, img: 'guide-sukiyaki.jpg' },
  { id: 'shabushabu', title: g.shabuTitle, steps: g.shabuSteps, img: 'guide-shabushabu.jpg' },
];
---
<Base lang={lang} page="guide" title={d.seo.guide.title} description={d.seo.guide.description}>
  <PageHead title={g.title} lead={g.lead} />
  <section class="section">
    <div class="wrap">
      {blocks.map((b) => (
        <article class="guide-block" id={b.id} aria-labelledby={`${b.id}-title`}>
          <img src={withBase('images/' + b.img)} alt="" width="1000" height="1250" loading="lazy" decoding="async" />
          <div>
            <h2 id={`${b.id}-title`}>{b.title}</h2>
            <ol class="steps">
              {b.steps.map((s) => <li><div><h3>{s.title}</h3><p>{s.body}</p></div></li>)}
            </ol>
            {b.id === 'sukiyaki' && (
              <div class="note-box"><h3>{g.eggTitle}</h3><p>{g.eggBody}</p></div>
            )}
          </div>
        </article>
      ))}
      <p class="more-link"><a class="btn btn-primary" href={pagePath(lang, 'reserve')}>{d.ui.reserve}</a></p>
    </div>
  </section>
</Base>
