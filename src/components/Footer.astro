---
import site from '../data/site.json';
import InstagramIcon from './InstagramIcon.astro';
import { LANGS, t, pagePath, pick, withBase, type Lang, type PageKey } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const navPages: PageKey[] = ['home', 'menu', 'lunch', 'banquet', 'welcome', 'recruit', 'guide', 'access', 'faq', 'reserve'];
const addr = lang === 'ja' ? site.address.ja : site.address.en;
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <img class="footer-logo" src={withBase('images/logo.webp')} alt={site.name.ja} width="480" height="537" loading="lazy" />
        <p>{pick(site.name, lang)}</p>
        <p>{addr}</p>
        <p><a href={`tel:${site.phoneIntl}`}>{lang === 'ja' ? site.phone : site.phoneIntlDisplay}</a></p>
        <p class="footer-sns"><a href={site.instagram} target="_blank" rel="noopener"><InstagramIcon /> Instagram {site.instagramHandle}</a></p>
      </div>
      <nav aria-label={d.nav.home}>
        <h2>{site.shortName}</h2>
        <ul>
          {navPages.map((p) => <li><a href={pagePath(lang, p)}>{(d.nav as any)[p]}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2>{d.ui.language}</h2>
        <ul>{LANGS.map((l) => <li><a href={pagePath(l, 'home')} lang={t(l).lang.html} hreflang={t(l).lang.html}>{t(l).lang.label}</a></li>)}</ul>
      </div>
    </div>
    <p class="copyright">© {year} {site.name.en}</p>
  </div>
</footer>
